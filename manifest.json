{
  "manifest_version": 3,
  "name": "Pure Path",
  "version": "1.0.0",
  "description": "Content filtering and accountability extension.",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },

  "action": {
    "default_popup": "dist/pages/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "permissions": [
    "webNavigation",
    "storage",
    "tabs",
    "activeTab"
  ],

  "host_permissions": [
    "http://localhost:3000/*",
    "<all_urls>"
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "dist/pages/block.html",
        "dist/pages/block.js",
        "dist/pages/testing-block.html",
        "dist/pages/testing-block.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}